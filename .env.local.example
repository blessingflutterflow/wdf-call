# Copy to .env.local and fill in. All values below are the same shape as
# RingaMo's — this app reuses RingaMo's Twilio + DIDLogic accounts, but has
# its own Firebase project. Nothing here is hardcoded in source, so swapping
# any of these later (new Twilio account, new DIDLogic account) is just an
# env var change — no code edit.

# ── Twilio ───────────────────────────────────────────────────────────────
# Account SID (starts AC...) — from the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=
# Auth Token — needed for SIP Domain / IP ACL admin calls (DIDLogic bridging).
TWILIO_AUTH_TOKEN=
# API Key SID/Secret (Console > Account > API keys & tokens) — used to mint
# Voice access tokens and for the REST calls that don't need admin scope.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App SID (Console > Voice > TwiML Apps) — its Voice Request URL should
# point at POST {PUBLIC_BASE_URL}/api/voice.
TWILIO_TWIML_APP_SID=
# Push Credential SID (Twilio Console > Notify > Credentials, or
# client.notify.v1.credentials.create) — tells Twilio which FCM project to
# push through to wake the Android app for an incoming call when it's
# backgrounded/killed. Without this, incoming calls only ring while the app
# is open in the foreground (the SDK's live connection still works then).
# Create one with: type=fcm, secret=<Firebase project's Legacy Cloud
# Messaging Server Key — Firebase Console > Project Settings > Cloud
# Messaging tab>. Must be a credential for THIS app's Firebase project, not
# a different product's — FCM tokens are project-scoped.
TWILIO_PUSH_CREDENTIAL_SID_ANDROID=
# Fallback caller ID used only if a user's own number can't be resolved.
TWILIO_PHONE_NUMBER=
# IP Access Control List SID containing DIDLogic's SIP gateway IPs — attached
# to every DIDLogic bridge domain this app creates (wdf-did-*.sip.twilio.com).
TWILIO_DIDLOGIC_ACL_SID=

# Regulatory bundle + address SIDs, required to purchase numbers in
# regulated countries (e.g. ZA). "mobile" and "local" are separate Twilio
# regulation types, each needs its own approved bundle.
TWILIO_BUNDLE_SID=
TWILIO_ADDRESS_SID=
TWILIO_BUNDLE_SID_LOCAL=
TWILIO_ADDRESS_SID_LOCAL=

# ── DIDLogic ─────────────────────────────────────────────────────────────
# API token from the DIDLogic account (app.didlogic.com).
DIDLOGIC_API_TOKEN=
# Shared outbound SIP gateway/trunk fallback, used only for bridges created
# before a number had its own dedicated DIDLogic SIP account.
DIDLOGIC_SIP_GATEWAY=
DIDLOGIC_SIP_USERNAME=
DIDLOGIC_SIP_PASSWORD=

# ── App ──────────────────────────────────────────────────────────────────
# Public origin of this deployment (e.g. https://wdf-call.vercel.app).
# Used to build webhook URLs (voice/inbound) instead of relying on
# request.url, which can be wrong behind some proxies.
PUBLIC_BASE_URL=

# ── Firebase (new project for this client — see SETUP.md) ────────────────
# These are public web-app config values (safe to expose client-side), from
# Firebase Console > Project settings > General > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
